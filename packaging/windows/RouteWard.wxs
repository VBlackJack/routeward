<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="RouteWard"
      Manufacturer="Julien Bombled"
      Version="$(var.MsiVersion)"
      UpgradeCode="C6F5A2B4-9E3A-4F81-8C12-9C4E12B7F801"
      Scope="perMachine">

    <!--
      Default schedule (RemoveExistingProducts right after InstallValidate): the old product is removed in
      its own transaction, before InstallInitialize. Do NOT use Schedule="afterInstallInitialize" to get
      a window for capturing the old state: a deferred custom action generated before
      RemoveExistingProducts makes Windows Installer fail the upgrade with error 2613 ("RemoveExistingProducts
      action sequenced incorrectly"), measured in a real upgrade from v2026.1121.1 (msiexec exit 1603).
      The protection state is therefore captured by an immediate action scheduled before InstallValidate,
      see "Protection kept across an upgrade" below.
    -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of RouteWard is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="RouteWardIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="RouteWardIcon.ico" />
    <Property Id="ARPCOMMENTS" Value="RouteWard $(var.DisplayVersion) - Choose which apps use your proxy and keep your real address private" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/VBlackJack/routeward" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!--
      Service restore after an upgrade. MajorUpgrade uninstalls the previous product
      (RemoveExistingProducts, scheduled right after InstallInitialize, in the same transaction as the new
      files), and its ServiceControl Remove="uninstall" deletes the RouteWard service together with the
      allow-sid arguments of its command line. AppSearch runs before that removal, so the old registration
      is captured here and replayed after InstallFiles by the custom actions below.
      Type="raw" keeps the value as stored: a REG_EXPAND_SZ ImagePath comes back with a "#%" prefix
      (stripped by the CLI) and the DWORD Start value as "#2" (automatic) or "#3" (manual).
    -->
    <Property Id="ROUTEWARD_OLD_IMAGEPATH" Secure="yes">
      <RegistrySearch
          Id="RouteWardOldImagePathSearch"
          Root="HKLM"
          Key="SYSTEM\CurrentControlSet\Services\RouteWard"
          Name="ImagePath"
          Type="raw" />
    </Property>
    <Property Id="ROUTEWARD_OLD_SVC_START" Secure="yes">
      <RegistrySearch
          Id="RouteWardOldServiceStartSearch"
          Root="HKLM"
          Key="SYSTEM\CurrentControlSet\Services\RouteWard"
          Name="Start"
          Type="raw" />
    </Property>

    <!--
      Deferred, no impersonation (runs as LocalSystem), run from the freshly installed routeward.exe.
      The captured ImagePath is passed unquoted after the end-of-options marker: the C runtime parsing of its own quotes
      yields one argument per token. The CLI re-validates every value (grammar, SIDs) and registers the
      NEW binary path, never the old one. "Return=ignore": a failed restore must not roll back the upgrade.
      The service is started again only when it was an automatic-start service (Start = 2).
    -->
    <CustomAction
        Id="RestoreServiceAutoStart"
        FileRef="RouteWardCliExe"
        ExeCommand="service restore --start -- [ROUTEWARD_OLD_IMAGEPATH]"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />
    <CustomAction
        Id="RestoreServiceDemandStart"
        FileRef="RouteWardCliExe"
        ExeCommand="service restore --demand-start -- [ROUTEWARD_OLD_IMAGEPATH]"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />

    <!--
      Rollback counterparts: if the install fails after a restore ran, remove the freshly registered service so
      it never points to a binary that the rollback deletes. A rollback action is scheduled before the deferred
      action it undoes and only runs when that deferred action already ran. "Return=ignore": best effort.
    -->
    <CustomAction
        Id="RollbackRestoreServiceAutoStart"
        FileRef="RouteWardCliExe"
        ExeCommand="service uninstall"
        Execute="rollback"
        Impersonate="no"
        Return="ignore" />
    <CustomAction
        Id="RollbackRestoreServiceDemandStart"
        FileRef="RouteWardCliExe"
        ExeCommand="service uninstall"
        Execute="rollback"
        Impersonate="no"
        Return="ignore" />

    <!--
      Uninstall cleanup. Both actions run from the still-installed routeward.exe, before RemoveFiles (the
      service was already stopped by StopServices, which precedes it), and only on a real removal:
      REMOVE~="ALL" is true for the uninstall session, and UPGRADINGPRODUCTCODE is set in the old product's
      uninstall session of a MajorUpgrade, so an upgrade never purges data nor restores the user's proxy.
      "Return=ignore": a failed cleanup must never block the uninstall.

      KEEPDATA (public, Secure): msiexec /x RouteWard.msi KEEPDATA=1 keeps %ProgramData%\RouteWard (the
      profile and the logs). Any non-empty value keeps them; omit it to delete them.

      PurgeProgramData: deferred, no impersonation (runs as LocalSystem), deletes %ProgramData%\RouteWard.
      The CLI refuses while a RouteWard daemon is active, refuses a directory that a standard user could
      write to, and never follows a link out of the directory. Accepted limit: the data is deleted before
      the rest of the uninstall has finished, so an uninstall that fails or is rolled back AFTER this
      action leaves the data deleted (KEEPDATA=1 avoids it).

      CleanupUserSettings: deferred, no impersonation (runs as LocalSystem), runs the CLI "cleanup" command with its all-users option:
      for every user whose registry hive is loaded under HKEY_USERS at that moment (every logged-on
      user, including the one running the uninstall, whose HKCU is not the installer's own), it restores
      or removes the RouteWard-owned values (system proxy, PAC URL, autostart entry) from that user's saved
      backup, only while they are still RouteWard's. Hives of users who are not logged on are NOT loaded
      (too intrusive), so those users keep their values and must fix them by hand: Settings > Network and
      Internet > Proxy, or Internet Options > Connections > LAN settings, or run the CLI "cleanup" command with its user option
      before the uninstall.

      The SYSTEM pass only reads each user's backup file through a verified handle (it must be a regular
      file at its expected place, owned by the user or by SYSTEM or the Administrators) and never creates,
      renames or deletes anything inside a user profile. If the check fails, only values equal to
      RouteWard's own are switched off. Race to know about: a RouteWard desktop still running in another
      user's session at uninstall time may write its settings again after this pass; the desktop also
      restores them when it exits or when that user logs off.

      Logging: both actions run through the WiX Util QuietExec custom action, so the command line and the
      console output of routeward.exe are written to the MSI log. That log only exists when the uninstall
      is run with logging (msiexec /x RouteWard.msi /l*v uninstall.log) or when the Windows Installer
      Logging policy is enabled: an uninstall started from Settings without logging leaves no trace.
      The build needs the WixToolset.Util.wixext extension (wix build -ext WixToolset.Util.wixext).
      QuietExec reads its command line from a property named after the action, hence the SetProperty
      rows with Before set to the action Id.

      TerminalServerAware is not set on any action: that flag only applies to impersonated deferred
      actions, and none of these impersonates the user.
    -->
    <!--
      Protection kept across an upgrade. Versions up to 2026.1121.x never persisted the desired protection
      state (protection_state.json), so the new daemon of a major upgrade finds no file and would leave
      protection off even though it was on. Two actions carry it over:

      CaptureOldProtectionStatus (immediate, impersonated, Before="InstallValidate"): runs the OLD
      "routeward.exe ctl status" and, only when the OLD daemon answers "running": true, records a
      registry marker in the hive of the user who runs the install: HKCU\Software\RouteWard\Upgrade, value
      ProtectionWasRunning, REG_DWORD 1. It always deletes that key first, so a leftover marker of an
      earlier abandoned upgrade can never survive into this one. Why this schedule: it must run while the
      old daemon still answers (RemoveExistingProducts has not run), and an immediate action does not
      generate script, which avoids error 2613 (measured, see MajorUpgrade above). It also runs before
      FilesInUse and Restart Manager (InstallValidate) had a chance to close or stop anything. Why a
      registry marker and not a file: the capture runs as the installing user, the migration runs as
      SYSTEM, and SYSTEM must never read a file from a place a standard user can write. The migration
      reads the marker through HKEY_USERS\<SID> with a link-safe open, believes only a REG_DWORD of 1 that
      is less than 30 minutes old, and deletes only that value.

      Who runs the capture: the installing user (filtered or full administrator token), or SYSTEM for an
      install pushed by SCCM or Intune (then the marker lives in HKEY_USERS\S-1-5-18).

      Command line: WixQuietExec in immediate mode reads the fixed property WixQuietExecCmdLine (formatted
      once by the action, then cleared) and requires it to start with a double quote. The SetProperty row
      below builds it; the references that must be resolved only by the action itself are escaped
      (the open bracket and close bracket escapes around RouteWardOldCli), so they are formatted once.
      [SystemFolder] is SysWOW64 on x64, harmless for cmd.exe. The command line has no brace (a Formatted
      string treats it as a reference). RouteWardOldCli is the path of the OLD routeward.exe built from the
      HKLM InstallDir value written by the old product; two rows cover a stored value with or without a
      trailing backslash (">>" is the MSI "ends with" operator). "Return=ignore": a failed capture must
      never block the upgrade.

      Accepted limits:
        (a) The pipe of the old daemon only admits SYSTEM, the Administrators group (full token) and the
            user SIDs it was started for. A different administrator upgrading with a filtered token is
            refused by the pipe: nothing is captured and protection stays off, as before this feature.
        (b) Where reg.exe is blocked (DisableRegistryTools policy, AppLocker or WDAC), nothing is
            captured and protection stays off, as before this feature.
        (c) Windows does not run commit actions when the DisableRollback policy is set; protection then
            stays off after the upgrade (the previous behavior).

      MigrateUpgradeState (commit, runs the NEW hidden "migrate-upgrade-state" command (with the user SID option) through
      WixQuietExec, like CleanupUserSettings and PurgeProgramData, so its log output reaches the installer
      log: the CLI logs to stderr, which a plain FileRef exe action would drop). WixQuietExec reads its
      command line from the CustomActionData property named after the action, and commit actions are
      deferred-class, so they receive CustomActionData exactly like deferred ones; the SetProperty below is
      therefore enough. [UserSID] is the SID of the user who runs the install (SYSTEM for SCCM). The command
      reads and consumes the marker and, only when the old daemon was running and no state file exists,
      turns protection on through the new daemon (or writes the enabled state when the daemon is not
      reachable). It never starts the service and never overwrites a state file. A commit action only runs
      once the whole transaction succeeded, so a rolled-back upgrade never leaves an enabled state behind.
    -->
    <Property Id="ROUTEWARD_OLD_INSTALLDIR" Secure="yes">
      <RegistrySearch
          Id="RouteWardOldInstallDirSearch"
          Root="HKLM"
          Key="Software\RouteWard"
          Name="InstallDir"
          Type="raw" />
    </Property>
    <SetProperty
        Id="RouteWardOldCli"
        Action="SetRouteWardOldCliWithSlash"
        Value="[ROUTEWARD_OLD_INSTALLDIR]routeward.exe"
        Before="SetRouteWardCaptureCmdLine"
        Sequence="execute"
        Condition="NOT REMOVE AND WIX_UPGRADE_DETECTED AND ROUTEWARD_OLD_INSTALLDIR AND ROUTEWARD_OLD_INSTALLDIR &gt;&gt; &quot;\&quot;" />
    <SetProperty
        Id="RouteWardOldCli"
        Action="SetRouteWardOldCliNoSlash"
        Value="[ROUTEWARD_OLD_INSTALLDIR]\routeward.exe"
        Before="SetRouteWardCaptureCmdLine"
        Sequence="execute"
        Condition="NOT REMOVE AND WIX_UPGRADE_DETECTED AND ROUTEWARD_OLD_INSTALLDIR AND NOT (ROUTEWARD_OLD_INSTALLDIR &gt;&gt; &quot;\&quot;)" />
    <SetProperty
        Id="WixQuietExecCmdLine"
        Action="SetRouteWardCaptureCmdLine"
        Value="&quot;[SystemFolder]cmd.exe&quot; /d /c &quot;reg delete HKCU\Software\RouteWard\Upgrade /f &gt;nul 2&gt;&amp;1 &amp; (&quot;[\[]RouteWardOldCli[\]]&quot; ctl status | findstr /c:&quot;\&quot;running\&quot;: true&quot; &gt;nul &amp;&amp; reg add HKCU\Software\RouteWard\Upgrade /v ProtectionWasRunning /t REG_DWORD /d 1 /f &gt;nul)&quot;"
        Before="CaptureOldProtectionStatus"
        Sequence="execute"
        Condition="NOT REMOVE AND WIX_UPGRADE_DETECTED AND ROUTEWARD_OLD_INSTALLDIR" />
    <CustomAction
        Id="CaptureOldProtectionStatus"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Return="ignore" />
    <SetProperty
        Id="MigrateUpgradeState"
        Value="&quot;[INSTALLFOLDER]routeward.exe&quot; migrate-upgrade-state --user-sid [UserSID]"
        Before="MigrateUpgradeState"
        Sequence="execute"
        Condition="NOT REMOVE AND WIX_UPGRADE_DETECTED AND ROUTEWARD_OLD_INSTALLDIR" />
    <CustomAction
        Id="MigrateUpgradeState"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="commit"
        Impersonate="no"
        Return="ignore" />

    <Property Id="KEEPDATA" Secure="yes" />

    <SetProperty
        Id="CleanupUserSettings"
        Value="&quot;[INSTALLFOLDER]routeward.exe&quot; cleanup --all-users"
        Before="CleanupUserSettings"
        Sequence="execute"
        Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    <CustomAction
        Id="CleanupUserSettings"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />
    <SetProperty
        Id="PurgeProgramData"
        Value="&quot;[INSTALLFOLDER]routeward.exe&quot; purge-data"
        Before="PurgeProgramData"
        Sequence="execute"
        Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND NOT KEEPDATA" />
    <CustomAction
        Id="PurgeProgramData"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="CaptureOldProtectionStatus" Before="InstallValidate" Condition="NOT REMOVE AND WIX_UPGRADE_DETECTED AND ROUTEWARD_OLD_INSTALLDIR" />
      <Custom Action="MigrateUpgradeState" Before="InstallFinalize" Condition="NOT REMOVE AND WIX_UPGRADE_DETECTED AND ROUTEWARD_OLD_INSTALLDIR" />
      <Custom Action="CleanupUserSettings" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="PurgeProgramData" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND NOT KEEPDATA" />
      <Custom Action="RollbackRestoreServiceAutoStart" Before="RestoreServiceAutoStart" Condition="NOT REMOVE AND (UPGRADINGPRODUCTCODE OR WIX_UPGRADE_DETECTED) AND ROUTEWARD_OLD_IMAGEPATH &lt;&gt; &quot;&quot; AND ROUTEWARD_OLD_SVC_START = &quot;#2&quot;" />
      <Custom Action="RollbackRestoreServiceDemandStart" Before="RestoreServiceDemandStart" Condition="NOT REMOVE AND (UPGRADINGPRODUCTCODE OR WIX_UPGRADE_DETECTED) AND ROUTEWARD_OLD_IMAGEPATH &lt;&gt; &quot;&quot; AND ROUTEWARD_OLD_SVC_START &lt;&gt; &quot;#2&quot;" />
      <Custom Action="RestoreServiceAutoStart" After="InstallFiles" Condition="NOT REMOVE AND (UPGRADINGPRODUCTCODE OR WIX_UPGRADE_DETECTED) AND ROUTEWARD_OLD_IMAGEPATH &lt;&gt; &quot;&quot; AND ROUTEWARD_OLD_SVC_START = &quot;#2&quot;" />
      <Custom Action="RestoreServiceDemandStart" After="InstallFiles" Condition="NOT REMOVE AND (UPGRADINGPRODUCTCODE OR WIX_UPGRADE_DETECTED) AND ROUTEWARD_OLD_IMAGEPATH &lt;&gt; &quot;&quot; AND ROUTEWARD_OLD_SVC_START &lt;&gt; &quot;#2&quot;" />
    </InstallExecuteSequence>

    <Feature Id="ProductFeature" Title="RouteWard" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ProgramDataComponents" />
      <ComponentRef Id="ApplicationShortcutComponent" />
      <ComponentRef Id="RestoreInternetShortcutComponent" />
      <?if $(var.IncludeWinDivert) = "yes" ?>
      <ComponentGroupRef Id="WinDivertComponents" />
      <?endif ?>
    </Feature>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="RouteWard" />
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="ProgramDataRouteWardFolder" Name="RouteWard" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="RouteWard" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="RouteWardCliComponent" Guid="D3B74B91-62B2-4F5B-89AA-1A7C4F8D2E10">
        <File Id="RouteWardCliExe" Source="$(var.StageDir)\routeward.exe" KeyPath="yes" />
        <ServiceControl
            Id="RouteWardServiceControl"
            Name="RouteWard"
            Stop="both"
            Remove="uninstall"
            Wait="yes" />
      </Component>

      <Component Id="RouteWardDesktopComponent" Guid="6F7B1D42-3C8A-4D7E-A9F5-9B2C1E4D8A31">
        <File Id="RouteWardDesktopExe" Source="$(var.StageDir)\routeward-desktop.exe" KeyPath="yes" />
      </Component>

      <Component Id="RouteWardScriptsAndDocsComponent" Guid="7E31C8D5-B90E-4A21-98E2-4C6F3A9B1D22">
        <File Id="InstallServiceScript" Source="$(var.StageDir)\install-service.ps1" KeyPath="yes" />
        <File Id="FetchWinDivertScript" Source="$(var.StageDir)\fetch-windivert.ps1" />
        <File Id="LicenseFile" Source="$(var.StageDir)\LICENSE" />
        <File Id="NoticeFile" Source="$(var.StageDir)\NOTICE" />
      </Component>

      <Component Id="RouteWardPathComponent" Guid="A914E3D1-5C6D-4A84-B67F-2F1E0E2A3104">
        <RegistryValue
            Root="HKLM"
            Key="Software\RouteWard"
            Name="InstallDir"
            Type="string"
            Value="[INSTALLFOLDER]"
            KeyPath="yes" />
        <Environment
            Id="RouteWardPathEnv"
            Name="PATH"
            Value="[INSTALLFOLDER]"
            Permanent="no"
            Part="last"
            Action="set"
            System="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ProgramDataComponents" Directory="ProgramDataRouteWardFolder">
      <Component Id="ProgramDataDirComponent" Guid="9A5C3B7D-2F41-4890-B3D6-1C8E7A4F5D12">
        <CreateFolder>
          <Permission User="SYSTEM" GenericAll="yes" />
          <Permission User="Administrators" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </ComponentGroup>

    <?if $(var.IncludeWinDivert) = "yes" ?>
    <ComponentGroup Id="WinDivertComponents" Directory="INSTALLFOLDER">
      <Component Id="WinDivertRuntimeComponent" Guid="5E8A12F0-4C3B-4E19-8D6A-3B7F2C1E9A05">
        <File Id="WinDivertDll" Source="$(var.StageDir)\WinDivert.dll" KeyPath="yes" />
        <File Id="WinDivertSys" Source="$(var.StageDir)\$(var.WinDivertSysName)" />
        <File Id="WinDivertLicense" Source="$(var.StageDir)\WinDivert-LICENSE.txt" />
        <File Id="WinDivertReadme" Source="$(var.StageDir)\WinDivert-README.txt" />
        <File Id="ThirdPartyNotices" Source="$(var.StageDir)\THIRD_PARTY_NOTICES.txt" />
        <!--
          The driver service is created by WinDivert.dll at run time, not by this package. Stop and remove it
          on install and uninstall so the driver file is never locked and no orphan service is left behind.
          A missing service is ignored by Windows Installer.
          Wait="no": StopServices order is not guaranteed, the driver can stay STOP_PENDING while RouteWard still holds
          its handle, and waiting would end in error 1921 after 30 s (fatal under /qn). RouteWard's own control waits.
        -->
        <ServiceControl
            Id="WinDivertServiceControl"
            Name="WinDivert"
            Stop="both"
            Remove="uninstall"
            Wait="no" />
      </Component>
    </ComponentGroup>
    <?endif ?>

    <Component Id="ApplicationShortcutComponent" Directory="ApplicationProgramsFolder" Guid="8C4D2E6F-1A9B-47C3-B5D8-6E2F9A0C1B44">
      <Shortcut
          Id="RouteWardStartMenuShortcut"
          Name="RouteWard"
          Description="Process-aware transparent proxy router and desktop UI"
          Target="[#RouteWardDesktopExe]"
          WorkingDirectory="INSTALLFOLDER"
          Icon="RouteWardIcon.ico" />
      <RemoveFolder Id="CleanUpApplicationProgramsFolder" On="uninstall" />
      <RegistryValue
          Root="HKLM"
          Key="Software\RouteWard"
          Name="StartMenuShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <!--
      "RouteWard - Restore Internet": the way back for a user who lost their connection while RouteWard is
      stopped or crashed. It runs the CLI "recover" command (gives the proxy and PAC settings back and stops the
      protection), then waits for the user to press Enter before the console closes (the pause-at-end option) so the
      result can be read.
      Its own component (own GUID and registry key path) so it can be added or removed independently of the
      main shortcut; the shared Start menu folder is removed together with the last shortcut.
    -->
    <Component Id="RestoreInternetShortcutComponent" Directory="ApplicationProgramsFolder" Guid="B27E5A91-4D3C-4F68-9A15-7C0D8E3B6F52">
      <Shortcut
          Id="RouteWardRestoreInternetShortcut"
          Name="RouteWard - Restore Internet"
          Description="Use this if your Internet stopped working: gives your normal connection back"
          Target="[#RouteWardCliExe]"
          Arguments="recover --pause-at-end"
          WorkingDirectory="INSTALLFOLDER"
          Icon="RouteWardIcon.ico" />
      <RemoveFolder Id="CleanUpRestoreInternetProgramsFolder" On="uninstall" />
      <RegistryValue
          Root="HKLM"
          Key="Software\RouteWard"
          Name="RestoreInternetShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>
  </Package>
</Wix>
