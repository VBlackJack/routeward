<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="RouteWard"
      Manufacturer="Julien Bombled"
      Version="$(var.MsiVersion)"
      UpgradeCode="C6F5A2B4-9E3A-4F81-8C12-9C4E12B7F801"
      Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of RouteWard is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="RouteWardIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="RouteWardIcon.ico" />
    <Property Id="ARPCOMMENTS" Value="RouteWard $(var.DisplayVersion) - Process-aware OS proxy router" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/VBlackJack/routeward" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!--
      Service restore after an upgrade. MajorUpgrade uninstalls the previous product first
      (RemoveExistingProducts), and its ServiceControl Remove="uninstall" deletes the RouteWard service
      together with the allow-sid arguments of its command line. AppSearch runs before that removal,
      so the old registration is captured here and replayed after InstallFiles by the custom actions below.
      Type="raw" keeps the value as stored: a REG_EXPAND_SZ ImagePath comes back with a "#%" prefix
      (stripped by the CLI) and the DWORD Start value as "#2" (automatic) or "#3" (manual).
    -->
    <Property Id="ROUTEWARD_OLD_IMAGEPATH" Secure="yes">
      <RegistrySearch
          Id="RouteWardOldImagePathSearch"
          Root="HKLM"
          Key="SYSTEM\CurrentControlSet\Services\RouteWard"
          Name="ImagePath"
          Type="raw" />
    </Property>
    <Property Id="ROUTEWARD_OLD_SVC_START" Secure="yes">
      <RegistrySearch
          Id="RouteWardOldServiceStartSearch"
          Root="HKLM"
          Key="SYSTEM\CurrentControlSet\Services\RouteWard"
          Name="Start"
          Type="raw" />
    </Property>

    <!--
      Deferred, no impersonation (runs as LocalSystem), run from the freshly installed routeward.exe.
      The captured ImagePath is passed unquoted after the end-of-options marker: the C runtime parsing of its own quotes
      yields one argument per token. The CLI re-validates every value (grammar, SIDs) and registers the
      NEW binary path, never the old one. "Return=ignore": a failed restore must not roll back the upgrade.
      The service is started again only when it was an automatic-start service (Start = 2).
    -->
    <CustomAction
        Id="RestoreServiceAutoStart"
        FileRef="RouteWardCliExe"
        ExeCommand="service restore --start -- [ROUTEWARD_OLD_IMAGEPATH]"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />
    <CustomAction
        Id="RestoreServiceDemandStart"
        FileRef="RouteWardCliExe"
        ExeCommand="service restore --demand-start -- [ROUTEWARD_OLD_IMAGEPATH]"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RestoreServiceAutoStart" After="InstallFiles" Condition="NOT REMOVE AND (UPGRADINGPRODUCTCODE OR WIX_UPGRADE_DETECTED) AND ROUTEWARD_OLD_IMAGEPATH &lt;&gt; &quot;&quot; AND ROUTEWARD_OLD_SVC_START = &quot;#2&quot;" />
      <Custom Action="RestoreServiceDemandStart" After="InstallFiles" Condition="NOT REMOVE AND (UPGRADINGPRODUCTCODE OR WIX_UPGRADE_DETECTED) AND ROUTEWARD_OLD_IMAGEPATH &lt;&gt; &quot;&quot; AND ROUTEWARD_OLD_SVC_START &lt;&gt; &quot;#2&quot;" />
    </InstallExecuteSequence>

    <Feature Id="ProductFeature" Title="RouteWard" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ProgramDataComponents" />
      <ComponentRef Id="ApplicationShortcutComponent" />
      <?if $(var.IncludeWinDivert) = "yes" ?>
      <ComponentGroupRef Id="WinDivertComponents" />
      <?endif ?>
    </Feature>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="RouteWard" />
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="ProgramDataRouteWardFolder" Name="RouteWard" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="RouteWard" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="RouteWardCliComponent" Guid="D3B74B91-62B2-4F5B-89AA-1A7C4F8D2E10">
        <File Id="RouteWardCliExe" Source="$(var.StageDir)\routeward.exe" KeyPath="yes" />
        <ServiceControl
            Id="RouteWardServiceControl"
            Name="RouteWard"
            Stop="both"
            Remove="uninstall"
            Wait="yes" />
      </Component>

      <Component Id="RouteWardDesktopComponent" Guid="6F7B1D42-3C8A-4D7E-A9F5-9B2C1E4D8A31">
        <File Id="RouteWardDesktopExe" Source="$(var.StageDir)\routeward-desktop.exe" KeyPath="yes" />
      </Component>

      <Component Id="RouteWardScriptsAndDocsComponent" Guid="7E31C8D5-B90E-4A21-98E2-4C6F3A9B1D22">
        <File Id="InstallServiceScript" Source="$(var.StageDir)\install-service.ps1" KeyPath="yes" />
        <File Id="FetchWinDivertScript" Source="$(var.StageDir)\fetch-windivert.ps1" />
        <File Id="LicenseFile" Source="$(var.StageDir)\LICENSE" />
        <File Id="NoticeFile" Source="$(var.StageDir)\NOTICE" />
      </Component>

      <Component Id="RouteWardPathComponent" Guid="A914E3D1-5C6D-4A84-B67F-2F1E0E2A3104">
        <RegistryValue
            Root="HKLM"
            Key="Software\RouteWard"
            Name="InstallDir"
            Type="string"
            Value="[INSTALLFOLDER]"
            KeyPath="yes" />
        <Environment
            Id="RouteWardPathEnv"
            Name="PATH"
            Value="[INSTALLFOLDER]"
            Permanent="no"
            Part="last"
            Action="set"
            System="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ProgramDataComponents" Directory="ProgramDataRouteWardFolder">
      <Component Id="ProgramDataDirComponent" Guid="9A5C3B7D-2F41-4890-B3D6-1C8E7A4F5D12">
        <CreateFolder>
          <Permission User="SYSTEM" GenericAll="yes" />
          <Permission User="Administrators" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </ComponentGroup>

    <?if $(var.IncludeWinDivert) = "yes" ?>
    <ComponentGroup Id="WinDivertComponents" Directory="INSTALLFOLDER">
      <Component Id="WinDivertRuntimeComponent" Guid="5E8A12F0-4C3B-4E19-8D6A-3B7F2C1E9A05">
        <File Id="WinDivertDll" Source="$(var.StageDir)\WinDivert.dll" KeyPath="yes" />
        <File Id="WinDivertSys" Source="$(var.StageDir)\$(var.WinDivertSysName)" />
        <File Id="WinDivertLicense" Source="$(var.StageDir)\WinDivert-LICENSE.txt" />
        <File Id="WinDivertReadme" Source="$(var.StageDir)\WinDivert-README.txt" />
        <File Id="ThirdPartyNotices" Source="$(var.StageDir)\THIRD_PARTY_NOTICES.txt" />
        <!--
          The driver service is created by WinDivert.dll at run time, not by this package. Stop and remove it
          on install and uninstall so the driver file is never locked and no orphan service is left behind.
          A missing service is ignored by Windows Installer.
        -->
        <ServiceControl
            Id="WinDivertServiceControl"
            Name="WinDivert"
            Stop="both"
            Remove="uninstall"
            Wait="yes" />
      </Component>
    </ComponentGroup>
    <?endif ?>

    <Component Id="ApplicationShortcutComponent" Directory="ApplicationProgramsFolder" Guid="8C4D2E6F-1A9B-47C3-B5D8-6E2F9A0C1B44">
      <Shortcut
          Id="RouteWardStartMenuShortcut"
          Name="RouteWard"
          Description="Process-aware transparent proxy router and desktop UI"
          Target="[#RouteWardDesktopExe]"
          WorkingDirectory="INSTALLFOLDER"
          Icon="RouteWardIcon.ico" />
      <RemoveFolder Id="CleanUpApplicationProgramsFolder" On="uninstall" />
      <RegistryValue
          Root="HKLM"
          Key="Software\RouteWard"
          Name="StartMenuShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>
  </Package>
</Wix>
