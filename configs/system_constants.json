        "javaw.exe"
      ],
      "defaultAction": "direct"
    },
    {
      "id": "app-dev",
      "i18nKey": "rules.visual_apps.dev",
      "icon": "code",
      "priority": 16,
      "processPatterns": [
        "Code.exe",
        "code",
        "git.exe",
        "git",
        "cargo.exe",
        "cargo",
        "node.exe",
        "node",
        "python.exe",
        "docker.exe"
      ],
      "defaultAction": "direct"
    },
    {
      "id": "app-media",
      "i18nKey": "rules.visual_apps.media",
      "icon": "music",
      "priority": 22,
      "processPatterns": [
        "Spotify.exe",
        "spotify",
        "vlc.exe",
        "vlc",
        "obs64.exe"
      ],
      "defaultAction": "direct"
    },
    {
      "id": "app-telemetry",
      "i18nKey": "rules.visual_apps.telemetry",
      "icon": "shield_ban",
      "priority": 11,
      "processPatterns": [
        "CompatTelRunner.exe",
        "DiagTrack",
        "crashpad_handler.exe",
        "software_reporter_tool.exe"
      ],
      "defaultAction": "block"
    }
  ]
}
